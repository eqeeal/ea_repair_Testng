<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Web Automation Suite">
    <test name="登录模块测试">
        <classes>
            <class name="tests.LoginTest"/>
        </classes>
    </test>

    <test name="零件模块测试">
        <parameter name="username" value="admin"></parameter>
        <parameter name="password" value="admin"></parameter>
        <parameter name="searchParts" value="川菜"></parameter>
        <parameter name="addpartsType" value="川菜1"></parameter>
        <groups>
            <run>
                <include name="smoke"></include>
                <include name="partsType"></include>
                <exclude name="handiwork"></exclude>
            </run>
        </groups>
        <classes>
                <class name="tests.PartsTest"/>
                <class name="tests.PartsTypeTest"/>
        </classes>
    </test>
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>
</suite>